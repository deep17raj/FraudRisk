# Copy to .env (never commit it) and `set -a; source .env; set +a` before running.

# --- Claude: the reasoning layer (signal selection, pattern naming, summary wording).
# Without a key the service still works: it falls back to the deterministic rule-vote path
# and the templated summary, and lands in the SAME risk band. Only the prose changes.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5   # claude-haiku-5-5 is the low-latency alternative
ANTHROPIC_EFFORT=low              # low | medium | high | xhigh | max - low suits this task
REASONING_MODE=auto               # auto = use the model when a key exists | llm | off
# Server-side fallback when a safety classifier declines the request. Uses the beta messages
# endpoint; switch off on Bedrock/Vertex/Foundry, which need client-side middleware instead.
ENABLE_LLM_FALLBACKS=1

# --- IP reputation. The default (ipwho.is) is keyless. A paid provider adds explicit
# VPN/proxy/Tor flags instead of ASN-ownership inference; `auto` prefers whichever is keyed.
IP_PROVIDER=auto                  # auto | ipwho | ipinfo | ip2location | none
IPINFO_TOKEN=
IP2LOCATION_KEY=

# --- Bulk feeds and lookups (all keyless; each can be switched off).
ENABLE_TOR_FEED=1                 # check.torproject.org exit list
ENABLE_PHISH_FEED=1               # openphish.com community feed
ENABLE_BIN_LOOKUP=1               # lookup.binlist.net (rate-limited: ~5/min unauthenticated)

# --- Time budgets (seconds). The global cap is what keeps Telegraph from seeing a timeout.
GLOBAL_TIMEOUT_S=11.5
GATHER_TIMEOUT_S=4.5
PROVIDER_TIMEOUT_S=3.0
REASONING_TIMEOUT_S=5.0
FEED_REFRESH_TIMEOUT_S=20.0

# --- Cache (seconds)
CACHE_TTL_S=900
CACHE_TTL_DEGRADED_S=30           # a partial provider failure is cached only briefly
CACHE_MAX_ITEMS=2000
FEED_TTL_S=3600

# Telegraph's on-chain encoding caps `subject` at 256 bytes; this limit applies to direct
# callers, who may send more.
MAX_SUBJECT_CHARS=2000

LOG_LEVEL=INFO
# HTTP_USER_AGENT="YourBot/1.0 (https://your-site; ops contact)"
