# Copy to .env (never commit it) and `set -a; source .env; set +a` before running.
#
# ONE service, 25 intents. A variable WITHOUT a prefix applies to every intent.
# To override it for one intent only, prefix it:
#     FRAUDRISK_<NAME>   FACTCHECK_<NAME>   AUDIT_<NAME>
#     IPGEO_<NAME>       EMAILSEC_<NAME>    URLSAFE_<NAME>    MALWARE_<NAME>
#     and, for intents/<package>, the package name upper-cased: SANCTIONS_<NAME>, CRYPTO_PRICE_<NAME>, ...
# e.g. FACTCHECK_ANTHROPIC_MODEL=claude-haiku-5-5 beats ANTHROPIC_MODEL for fact-check only.
# Leave timeouts / cache TTLs UNSET unless you mean to change all seven: each intent has its
# own tuned default (GLOBAL_TIMEOUT_S is 11.5 s for fact-check, 13.5 s for the contract audit,
# 6 s for the IP, e-mail and URL checks and 10 s for malware).

# --- Shared
ANTHROPIC_API_KEY=
LOG_LEVEL=INFO
ENABLE_LLM_FALLBACKS=1
# HTTP_USER_AGENT="YourBot/1.0 (https://your-site; ops contact)"

# --- Per-intent model choice (no key => every intent still answers, keyless/heuristic path)
FRAUDRISK_ANTHROPIC_MODEL=claude-opus-5-5
FRAUDRISK_ANTHROPIC_EFFORT=low        # low | medium | high | xhigh | max
FACTCHECK_ANTHROPIC_MODEL=claude-haiku-5-5   # fast: the whole request must finish in ~12 s
AUDIT_ANTHROPIC_MODEL=claude-opus-5-5
AUDIT_ANTHROPIC_EFFORT=low

# --- FRAUD_RISK_GENERAL (/fraud-risk)
REASONING_MODE=auto                   # auto = use the model when a key exists | llm | off
IP_PROVIDER=auto                      # auto | ipwho | ipinfo | ip2location | none
IPINFO_TOKEN=
IP2LOCATION_KEY=
ENABLE_TOR_FEED=1
ENABLE_PHISH_FEED=1
ENABLE_BIN_LOOKUP=1

# --- FACT_CHECK_GENERAL (/fact-check)
STANCE_MODE=auto                      # auto | llm | heuristic
SEARCH_PROVIDER=auto                  # auto | tavily | serper | brave | none  (Wikipedia needs no key)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
ENABLE_NEWS=1
GOOGLE_FACTCHECK_API_KEY=             # Google Fact Check Tools API (free)

# --- CONTRACT_OBLIGATION_AUDIT_GENERAL (/audit)
EXTRACTION_MODE=auto                  # auto | llm | off
ENABLE_URL_FETCH=1
MAX_FETCH_BYTES=8000000
MAX_REDIRECTS=3
ALLOW_PRIVATE_HOSTS=0                 # leave OFF: it is the SSRF guard
MAX_CONTRACT_CHARS=120000

# --- IP_GEOLOCATION_GENERAL (/ip-geolocation): no key needed
GEO_PROVIDERS=all                    # all | a subset such as "ipinfo,ipwho" (ipinfo, ipwho, ipapi_co, freeipapi, geojs)
GEO_CLUSTER_KM=100                   # fixes within this radius agree; the largest cluster wins
# IPINFO_TOKEN (above) also lifts ipinfo.io's keyless rate limit

# --- EMAIL_SECURITY_GENERAL (/email-security): no key needed (Google + Cloudflare DNS-over-HTTPS)
DNS_GRACE_S=0.4                      # wait this long for the preferred resolver when only the fallback answered

# --- URL_SAFE_GENERAL (/url-safe): no key needed
ENABLE_DNS_BLOCKLIST=1               # Cloudflare security DNS (also used by malware for domains)
SUSPICIOUS_WEIGHT=0.6                # structural red flags at or above this make an unlisted address Suspicious
# ENABLE_PHISH_FEED (above) also controls the OpenPhish feed for urlsafe and malware

# --- MALWARE_DETECTION_HASH (/malware-detection): no key needed
ENABLE_CIRCL=1                       # CIRCL hashlookup (MD5 / SHA-1 / SHA-256; explicit KnownMalicious flag)
ENABLE_CYMRU=1                       # Team Cymru malware hash registry (MD5 / SHA-1, over DNS)
ENABLE_OTX=1                         # AlienVault OTX public indicator API (any hash, domain, IP)
CYMRU_MIN_DETECTION=50               # percent of antivirus engines that must detect an MD5 / SHA-1
OTX_MIN_PULSES_HASH=1                # OTX threat reports citing a hash
OTX_MIN_PULSES_HOST=5                # OTX threat reports citing a domain or IP
CIRCL_TIMEOUT_S=4
OTX_TIMEOUT_S=6

# --- intents/ (docs/MoreIntents.md): all keyless. Prefix a variable with the package name to scope it,
# --- e.g. SANCTIONS_GLOBAL_TIMEOUT_S. Do NOT set the shared CACHE_TTL_S / GLOBAL_TIMEOUT_S for all of them.
NVD_API_KEY=                          # optional (cve, vulntriage): lifts NVD's keyless rate limit
SEC_USER_AGENT=                       # optional (sec_filings): identify yourself to SEC EDGAR, "Name contact@example.com"
IPSUM_MIN_LISTS=2                     # threatintel: IPsum blocklists that must carry an IP before it is reported
MATCH_THRESHOLD=0.88                  # sanctions: best name score at or above this is a match
LIST_TTL_S=21600                      # sanctions: re-download the OFAC lists this often
LIST_TIMEOUT_S=40                     # sanctions: per-file download timeout
OUTLIER_PCT=3                         # crypto_price: a reading this far (percent) from the median is dropped
SOFT_DEADLINE_S=1.2                   # crypto_price: stop waiting for slower exchanges once one has answered
MIN_NAME_SCORE=0.8                    # corporate_registry: how closely a GLEIF name must resemble the request
ALLOW_PRIVATE_HOSTS=0                 # ssl_cert: leave OFF, it is the SSRF guard (also used by audit)

# --- Groq (OPTIONAL). WEB_SEARCH, CHAT_COMPLETION, RESEARCH_QUERY, SECURITY_REVIEW and EVENT_OUTCOME answer from public
# --- sources with no key at all; with a key, Groq writes/judges the answer from those same sources. If Groq is missing,
# --- rate-limited (429), rejects the key (401), retires a model, errors or is slow, the intent silently uses the keyless
# --- answer: the server never stops and never returns an empty answer. Set the key in the Render dashboard, not in a file.
GROQ_API_KEY=                         # from console.groq.com; never commit it
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant   # best first; copy current ids from your Groq console, retired ones are skipped
GROQ_TIMEOUT_S=6                      # one Groq attempt (also capped by the time left in the request)
GROQ_MAX_TOKENS=700
LLM_MARGIN_S=1.5                      # time kept back to build the keyless answer if Groq is slow
OPENALEX_API_KEY=                     # optional (research_query): OpenAlex's free daily budget is shared per IP
MAX_SOURCES=6                         # web_search / research_query: documents kept per answer
# TAVILY_API_KEY / BRAVE_API_KEY / SERPER_API_KEY (above) also improve web_search when set.

# --- sla_compliance: public Upptime repositories (owner/repo, comma separated) whose history/summary.json is read
UPPTIME_REPOS=upptime/upptime

