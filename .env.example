# Copy to .env (never commit it) and `set -a; source .env; set +a` before running.
#
# ONE service, three intents. A variable WITHOUT a prefix applies to all three intents.
# To override it for one intent only, prefix it:
#     FRAUDRISK_<NAME>   FACTCHECK_<NAME>   AUDIT_<NAME>
# e.g. FACTCHECK_ANTHROPIC_MODEL=claude-haiku-5-5 beats ANTHROPIC_MODEL for fact-check only.
# Leave timeouts / cache TTLs UNSET unless you mean to change all three: each intent has its
# own tuned default (GLOBAL_TIMEOUT_S is 11.5 s for fact-check, 13.5 s for the contract audit).

# --- Shared
ANTHROPIC_API_KEY=
LOG_LEVEL=INFO
ENABLE_LLM_FALLBACKS=1
# HTTP_USER_AGENT="YourBot/1.0 (https://your-site; ops contact)"

# --- Per-intent model choice (no key => every intent still answers, keyless/heuristic path)
FRAUDRISK_ANTHROPIC_MODEL=claude-opus-5-5
FRAUDRISK_ANTHROPIC_EFFORT=low        # low | medium | high | xhigh | max
FACTCHECK_ANTHROPIC_MODEL=claude-haiku-5-5   # fast: the whole request must finish in ~12 s
AUDIT_ANTHROPIC_MODEL=claude-opus-5-5
AUDIT_ANTHROPIC_EFFORT=low

# --- FRAUD_RISK_GENERAL (/fraud-risk)
REASONING_MODE=auto                   # auto = use the model when a key exists | llm | off
IP_PROVIDER=auto                      # auto | ipwho | ipinfo | ip2location | none
IPINFO_TOKEN=
IP2LOCATION_KEY=
ENABLE_TOR_FEED=1
ENABLE_PHISH_FEED=1
ENABLE_BIN_LOOKUP=1

# --- FACT_CHECK_GENERAL (/fact-check)
STANCE_MODE=auto                      # auto | llm | heuristic
SEARCH_PROVIDER=auto                  # auto | tavily | serper | brave | none  (Wikipedia needs no key)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
ENABLE_NEWS=1
GOOGLE_FACTCHECK_API_KEY=             # Google Fact Check Tools API (free)

# --- CONTRACT_OBLIGATION_AUDIT_GENERAL (/audit)
EXTRACTION_MODE=auto                  # auto | llm | off
ENABLE_URL_FETCH=1
MAX_FETCH_BYTES=8000000
MAX_REDIRECTS=3
ALLOW_PRIVATE_HOSTS=0                 # leave OFF: it is the SSRF guard
MAX_CONTRACT_CHARS=120000
